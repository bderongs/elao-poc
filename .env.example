# Which model does what, live: /admin/system-config shows the running
# environment's actual values; README.md ("Modèles utilisés") explains them.

# Gradium — examiner's voice (TTS) for en/fr/es/de (lib/tts/providers/gradium.ts),
# EU endpoint (eu.api.gradium.ai). Its streaming STT is wired but switched off
# (lib/realtime-stt-config.ts).
# https://gradium.ai/
GRADIUM_API=

# Azure Speech Services — examiner's voice (TTS) for nl-BE/it, and the acoustic
# half of the LIVE pronunciation score for every language (azure-ensemble,
# lib/pronunciation/providers/azure-ensemble.ts). Not used for transcription.
# https://portal.azure.com/
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Mistral — conversation, transcription, CEFR evaluation, pronunciation judge
# https://console.mistral.ai/
MISTRAL_API_KEY=
# End-of-session CEFR evaluation (and the default for the two below).
MISTRAL_MODEL=mistral-large-latest
# Optional: the examiner conversation, the per-answer level judge (ET) and
# topic tracking (defaults to MISTRAL_MODEL) — e.g. mistral-small-latest for
# faster replies, without touching the final CEFR evaluation.
MISTRAL_CHAT_MODEL=
# Optional: the judge in the live pronunciation score (defaults to MISTRAL_MODEL)
MISTRAL_PRONUNCIATION_MODEL=
# Optional: Voxtral (audio-input) model, used only by the "voxtral" pronunciation
# provider in the admin pronunciation lab — defaults to voxtral-small-latest
MISTRAL_VOXTRAL_MODEL=
# Optional: dedicated transcription-endpoint model for the live conversation's
# turn-taking (app/api/transcribe/route.ts) — defaults to voxtral-mini-latest.
# This is the FALLBACK path (lib/realtime-stt-config.ts's REALTIME_STT_ENABLED
# off, or the realtime path unavailable/timed out this turn) — see below.
MISTRAL_TRANSCRIBE_MODEL=
# Optional: streaming counterpart to MISTRAL_TRANSCRIBE_MODEL — the browser
# connects directly to this model's WebSocket endpoint (app/api/realtime-token
# mints a short-lived token server-side; lib/realtime-stt.ts holds the
# connection) instead of waiting for the user to finish and uploading a full
# clip. Defaults to voxtral-mini-transcribe-realtime-2602.
MISTRAL_REALTIME_TRANSCRIBE_MODEL=

# Deepgram (nova-3) — the independent transcription in the LIVE pronunciation
# score for every language (azure-ensemble). Without it the score falls back
# to Azure's acoustic result alone.
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Anthropic — admin only: comparison evaluations in the eval lab (/admin/[id])
# and the simulated learner in the simulator. Never used in a live session.
# Optional; without it those runs just show an error.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Supabase — https://supabase.com (choose eu-central-1 / Frankfurt region)
# Server-only: sessions are written via /api/sessions (service role), never
# from the browser. Find both in Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Same project, browser-exposed publishable key — powers Supabase Auth
# (email + password sign-in for both /admin and end users) from client
# components. Project Settings > API > Publishable key.
# Supabase dashboard: Authentication > Providers > Email > "Confirm email" OFF
# (sign-up logs in immediately), minimum password length 8.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# "Continuer avec Google" button (components/AuthForm.tsx) — renders disabled
# until this is "true". Enable the Google provider in Supabase first.
# NEXT_PUBLIC_GOOGLE_AUTH_ENABLED=true

# Score callback (lib/score-callback.ts, Track AG) — optional. Not activated
# by default (SCORE_CALLBACK.enabled = false); the URL defaults to
# https://www.elao-test.com/callback. The secret signs the body (HMAC-SHA256,
# X-Elao-Signature header).
SCORE_CALLBACK_URL=
SCORE_CALLBACK_SECRET=

# Optional — signs the live CEFR evaluation between /api/evaluate and the
# final save, so a candidate can't post a made-up level
# (lib/evaluation-signature.ts). Defaults to a key derived from
# SUPABASE_SERVICE_ROLE_KEY; set it only to rotate independently.
EVALUATION_SIGNING_SECRET=

# Optional post-assessment satisfaction survey (components/SatisfactionModal.tsx)
# — set to 1 to show a short modal on the results screen; answers are stored
# in the session_feedback table. Off by default.
NEXT_PUBLIC_SATISFACTION_MODAL=
