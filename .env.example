# Azure Speech Services — STT, TTS, and pronunciation assessment
# https://portal.azure.com/
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Mistral — conversation, CEFR evaluation, pronunciation judge
# https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# Optional: separate model for pronunciation judging (defaults to MISTRAL_MODEL)
MISTRAL_PRONUNCIATION_MODEL=

# Deepgram — optional second ASR signal for pronunciation pass-2
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# OpenAI — legacy Whisper route only (/api/transcribe, unused by main UI)
# https://platform.openai.com/
OPENAI_API_KEY=

# Avaturn 3-D avatar — paste the GLB URL from your Avaturn export
# Free tier: 100 exports/month · avaturn.me
NEXT_PUBLIC_AVATURN_URL=

# HeyGen Streaming Avatar — https://app.heygen.com/avatar
# Set NEXT_PUBLIC_HEYGEN_ENABLED=true to replace the 3-D/SVG avatar with a
# photorealistic HeyGen avatar. Requires a HeyGen API key and an avatar ID.
# Avatar IDs are found in the HeyGen dashboard under "Avatars".
# Cost: ~1 credit/minute of session time.
HEYGEN_API_KEY=
HEYGEN_AVATAR_ID=
NEXT_PUBLIC_HEYGEN_ENABLED=false

# Supabase — https://supabase.com (choose eu-central-1 / Frankfurt region)
# Server-only: sessions are written via /api/sessions (service role), never
# from the browser. Find both in Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Admin tool (/admin) — single shared password, v1 gate only, not real auth.
ADMIN_PASSWORD=
