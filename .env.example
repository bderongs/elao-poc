# Azure Speech Services — TTS for 4 of 6 languages (Dutch-BE/Spanish/Italian/
# German; English/French use Mistral TTS instead), plus the admin-only
# azure-ensemble pronunciation-lab provider. No longer used for live STT —
# see MISTRAL_TRANSCRIBE_MODEL below.
# https://portal.azure.com/
AZURE_SPEECH_KEY=
AZURE_SPEECH_REGION=westeurope

# Mistral — conversation, CEFR evaluation, pronunciation judge
# https://console.mistral.ai/
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-large-latest
# Optional: separate model for the live conversation call specifically
# (defaults to MISTRAL_MODEL) — e.g. mistral-small-latest to trade reply
# quality for lower/more consistent latency, without touching the
# end-of-session CEFR evaluation, which always uses MISTRAL_MODEL.
MISTRAL_CHAT_MODEL=
# Optional: separate model for pronunciation judging (defaults to MISTRAL_MODEL)
MISTRAL_PRONUNCIATION_MODEL=
# Optional: Voxtral (audio-input) model, used only by the "voxtral" pronunciation
# provider in the admin pronunciation lab — defaults to voxtral-small-latest
MISTRAL_VOXTRAL_MODEL=
# Optional: dedicated transcription-endpoint model for the live conversation's
# turn-taking (app/api/transcribe/route.ts) — defaults to voxtral-mini-latest
MISTRAL_TRANSCRIBE_MODEL=

# Qwen3-Omni (Alibaba Cloud DashScope) — DEV-TEST SCAFFOLD ONLY, not wired into
# system-config or the admin Lab Panel. lib/pronunciation/providers/qwen.ts,
# comparing against voxtral.ts on low-CEFR-level accuracy.
# https://dashscope.console.aliyun.com/
DASHSCOPE_API_KEY=
# Optional — defaults to qwen3-omni-flash
QWEN_MODEL=
# Optional — defaults to the international (Singapore) endpoint; switch to
# https://dashscope.aliyuncs.com/compatible-mode/v1 for a mainland account
QWEN_DASHSCOPE_BASE_URL=

# Deepgram — admin-only, powers the azure-ensemble pronunciation-lab provider
# as a comparison run (lib/pronunciation/providers/azure-ensemble.ts). Not
# used by the live conversation, which defaults to the voxtral provider.
# https://console.deepgram.com/
DEEPGRAM_API_KEY=

# Anthropic — comparison-only provider in the eval lab (/admin/[id]),
# not used by the live conversation flow. Optional; without it, Anthropic
# replay evaluations just show an error in the eval lab table.
# https://console.anthropic.com/
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-sonnet-4-5

# Ready Player Me 3-D avatar — paste the GLB export URL for the conversation
# avatar (rendered client-side via @met4citizen/talkinghead, lip-synced in
# real time from the TTS audio via wawa-lipsync). Must include
# ?morphTargets=ARKit,Oculus+Visemes,... — see readyplayer.me. Free for
# non-commercial use; commercial use requires notifying Ready Player Me.
# Falls back to TalkingHead's own public demo avatar if unset.
NEXT_PUBLIC_AVATAR_GLB_URL=

# Supabase — https://supabase.com (choose eu-central-1 / Frankfurt region)
# Server-only: sessions are written via /api/sessions (service role), never
# from the browser. Find both in Project Settings > API.
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Same project, browser-exposed publishable key — powers Supabase Auth
# (magic-link sign-in for both /admin and end users) from client components.
# Project Settings > API > Publishable key.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
